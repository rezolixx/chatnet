# Published account destination. May be an absolute HTTPS URL or local path.
NEXT_PUBLIC_LOGIN_URL=

# Published support mailbox; leave empty until confirmed.
NEXT_PUBLIC_CONTACT_EMAIL=

# Server-only Laravel API base for member and registered-channel reads.
API_BASE_URL=https://laravel.discut.org

# Optional localhost-only location lookup. Enabling sends the development
# server's public egress IP to ipapi.co; leave unset unless approved.
# DEV_LOCATION_FALLBACK=ipapi
