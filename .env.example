# Published account destination. May be an absolute HTTPS URL or local path.
NEXT_PUBLIC_LOGIN_URL=

# Published support mailbox; leave empty until confirmed.
NEXT_PUBLIC_CONTACT_EMAIL=

# Server-only Laravel API base for member and registered-channel reads.
API_BASE_URL=https://laravel.discut.org

# Server-only. Same value (32+ characters) as Laravel's CHATNET_CLIENT_IP_SECRET:
# lets the sign-in/registration bridge name the visitor address Laravel rate-limits.
CHATNET_CLIENT_IP_SECRET=

# Server-only read-only Game API base (game-system apps/api), e.g. https://jeux-api.example.
# HTTPS required (HTTP only on localhost). Leave empty until the API is deployed:
# /jeux pages then show an honest "rankings not yet published" state.
GAME_API_BASE_URL=
# Set to true only once GameBot is live in #quiz on the production network.
GAMES_QUIZ_OPEN=

# Optional server-only search engine site verification values.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# IndexNow ownership key, served at /indexnow-key.txt.
INDEXNOW_KEY=
# Server-to-server token required to trigger canonical URL submission.
INDEXNOW_TRIGGER_SECRET=

# Optional localhost-only location lookup. Enabling sends the development
# server's public egress IP to ipapi.co; leave unset unless approved.
# DEV_LOCATION_FALLBACK=ipapi
